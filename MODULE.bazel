module(
    name = "sonic-dash-ha",
    version = "0.0.1",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "tar.bzl", version = "0.10.5.sonic.2")
bazel_dep(name = "protobuf-legacy", version = "3.21.12.sonic.4", repo_name = "protobuf_legacy")
bazel_dep(name = "sonic-rust-deps", version = "0.0.5-4064a814e8530300a7acbad4a9aff0621e2fb98e", repo_name = "sonic_rust_deps")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")
bazel_dep(name = "sonic-dash-api", version = "0.0.6-55310bf7437d67411418c974587adcdc1b194d6b", repo_name = "sonic_dash_api")
bazel_dep(name = "sonic-build-infra", version = "0.0.44-35726399908a3beb947174e9359f902077928289", repo_name = "sonic_build_infra")

# Align the shared native toolchain with the maintained infrastructure source.
# SWSS Common's older commit sorts higher. Pin the crates selected by Cargo.lock.
single_version_override(
    module_name = "sonic-rust-deps",
    version = "0.0.5-4064a814e8530300a7acbad4a9aff0621e2fb98e",
)

single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.44-35726399908a3beb947174e9359f902077928289",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "rules_go",
    version = "0.65.0.sonic.2",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# The shared owner reads canonical Cargo inputs directly with rules_rs.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains("@python_3_13//:all")

bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(
    dependency_sets = ["trixie"],
    lock = "@sonic_build_infra//apt:apt.lock.json",
    requests = "@sonic_build_infra//apt:requests.json",
    sources = "@sonic_build_infra//apt:sources.json",
)
use_repo(apt, "trixie")
